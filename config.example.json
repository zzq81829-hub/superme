{
  "port": 3210,
  "host": "127.0.0.1",
  "workspaceRoot": "",
  "dryRun": true,
  "proxy": {
    "enabled": true,
    "url": "http://127.0.0.1:7890"
  },
  "computerAccess": {
    "enabled": true,
    "mode": "read-only-privacy-filtered"
  },
  "execution": {
    "timeoutMs": 600000,
    "maxOutputBytes": 2097152,
    "verificationTimeoutMs": 120000,
    "maxRepairAttempts": 1
  },
  "agents": {
    "codex": {
      "enabled": true,
      "command": "codex",
      "args": [],
      "sandbox": "workspace-write",
      "model": "gpt-5.6-luna",
      "modelReasoningEffort": "max",
      "timeoutMs": 600000,
      "workingDirectory": ""
    },
    "claude": {
      "enabled": true,
      "command": "claude",
      "model": "claude-sonnet-4-6"
    },
    "antigravity": {
      "enabled": true,
      "command": "agy",
      "args": [],
      "mode": "accept-edits",
      "model": "gemini-3.8-flash-high",
      "boost": true,
      "effort": "high",
      "permissionMode": "configured",
      "sandbox": false,
      "timeoutMs": 600000,
      "workingDirectory": ""
    }
  },
  "bridge": {
    "enabled": true,
    "token": "change-me",
    "allowedOrigins": [
      "https://chatgpt.com",
      "https://chat.openai.com"
    ]
  }
}
