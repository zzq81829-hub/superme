      "sandbox": false,
      "timeoutMs": 600000,
      "workingDirectory": ""
    }
  },
  "bridge": {
    "enabled": true,
    "token": "change-me",
    "allowedOrigins": [
      "https://chatgpt.com",
      "https://chat.openai.com"
    ]
